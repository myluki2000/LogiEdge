@using Havit.Blazor.Components.Web.Bootstrap
@using LogiEdge.BaseService.Data
@using LogiEdge.BaseService.MemoryCache
@using LogiEdge.BaseService.Services
@using LogiEdge.Service.DocumentGenerator.DocumentGeneration
@using LogiEdge.Service.DocumentGenerator.Dto
@using LogiEdge.Service.DocumentGenerator.Services
@using System.Text.Json

@inject DocumentGenerationService DocumentGenerationService
@inject MemoryCacheService MemoryCacheService

@typeparam TInputType where TInputType : LogiEdge.Shared.IDocumentGeneratorInput

@code {
    [Parameter]
    public required Func<Task<TInputType>> InputDataFunc { get; set; }
    /// <summary>
    /// Callback which is raised when the user presses save for the generated document.
    /// </summary>
    [Parameter]
    public required EventCallback<GeneratedDocumentDto> OnFileAttachmentSaveRequested { get; set; }
    /// <summary>
    /// Returns the previously persisted userInput JSON for pre-filling the input form (or null). Fetched once per modal open.
    /// </summary>
    [Parameter]
    public Func<Task<string?>>? PreFilledUserInputFunc { get; set; }

    private List<IDocumentGenerator<TInputType>> Templates { get; set; } = [];

    private HxModal _documentGenerationModal = null!;

    private IDocumentGenerator<TInputType>? _selectedGenerator;
    private HtmlDocumentGenerationTemplateDto? _inputFormTemplate;
    private string? _formContextJson;
    private string? _contextBuildError;
    private string? _preFilledUserInput;
    private InputFormIframeComponent? _inputForm;
    private string? _lastCollectedValues;
    private string? _formError;
    private bool _showCollectedValues = false;

    private GeneratedDocumentDto? _generatedFileAttachment = null;
    private Guid? _cachedOutputDocId = null;

    private static readonly JsonSerializerOptions ContextJsonSerializerOptions = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    private static readonly JsonSerializerOptions PrettyPrintJsonSerializerOptions = new() { WriteIndented = true };

    private bool HasInputForm => _inputFormTemplate != null && _contextBuildError == null;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        Templates = await DocumentGenerationService.GetGeneratorsForDocumentType<TInputType>().ToListAsync();
        _selectedGenerator = null;
    }

    private async Task BtnGenerateDocumentOnClick()
    {
        // Fetch the pre-fill value once per modal open.
        _preFilledUserInput = PreFilledUserInputFunc is { } func ? await func.Invoke() : null;
        await _documentGenerationModal.ShowAsync();
    }

    private async Task OnSelectedGeneratorChanged(IDocumentGenerator<TInputType>? generator)
    {
        // Reset form state — switching templates discards entered values.
        _selectedGenerator = generator;
        _inputFormTemplate = null;
        _formContextJson = null;
        _contextBuildError = null;
        _lastCollectedValues = null;
        _formError = null;

        if (generator?.Template is HtmlDocumentGenerationTemplateDto template && !string.IsNullOrWhiteSpace(template.InputFormHtml))
        {
            _inputFormTemplate = template;
            try
            {
                TInputType documentData = await InputDataFunc.Invoke();
                JsonElement? preFilled = null;
                if (!string.IsNullOrWhiteSpace(_preFilledUserInput))
                {
                    using JsonDocument preFilledDocument = JsonDocument.Parse(_preFilledUserInput);
                    preFilled = preFilledDocument.RootElement.Clone();
                }

                object context = new
                {
                    documentData,
                    preFilled,
                    rpcAvailable = new[] { "getCustomers" }
                };
                _formContextJson = JsonSerializer.Serialize(context, ContextJsonSerializerOptions);
            }
            catch (Exception exception)
            {
                _contextBuildError = exception.Message; // show an error state instead of crashing
            }
        }
    }

    private async Task ModalBtnGenerateOnClick()
    {
        if (_selectedGenerator != null)
        {
            string? userInputJson = null;
            if (HasInputForm)
            {
                if (_formError != null) // a previous form error disables Generate until the form recovers
                {
                    StateHasChanged();
                    return;
                }

                if (_inputForm is not { IsReady: true } inputForm)
                {
                    _formError = "Input form is not ready yet.";
                    StateHasChanged();
                    return;
                }

                (string? valuesJson, string? collectError) = await inputForm.CollectAsync();
                if (collectError != null)
                {
                    _formError = collectError;
                    StateHasChanged();
                    return;
                }

                try
                {
                    UserInputJson.Validate(valuesJson);
                }
                catch (ArgumentException exception)
                {
                    _formError = exception.Message;
                    StateHasChanged();
                    return;
                }

                userInputJson = valuesJson;
                _lastCollectedValues = valuesJson;
                _formError = null;
            }

            TInputType inputData = await InputDataFunc.Invoke();
            _generatedFileAttachment = await DocumentGenerationService.GenerateDocument(_selectedGenerator, inputData, userInputJson);
            _cachedOutputDocId = MemoryCacheService.CacheFile(new CachedFile()
            {
                Data = _generatedFileAttachment.Data,
                MimeType = _generatedFileAttachment.ContentType,
                ServeAtEndpoint = true
            }, TimeSpan.FromHours(1));
        }
    }

    private async Task ModalBtnSaveGeneratedDocumentOnClick()
    {
        if (_generatedFileAttachment == null)
            return;

        await OnFileAttachmentSaveRequested.InvokeAsync(_generatedFileAttachment);
        await _documentGenerationModal.HideAsync();
    }

    private static string PrettyPrintJson(string json)
    {
        try
        {
            using JsonDocument document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, PrettyPrintJsonSerializerOptions);
        }
        catch (JsonException)
        {
            return json;
        }
    }
}

<HxButton Color="ThemeColor.Secondary" Text="Generate Document" OnClick="BtnGenerateDocumentOnClick" />

<HxModal @ref="_documentGenerationModal" Title="Generate Document" Fullscreen="ModalFullscreen.Always">
    <BodyTemplate>
        <div class="row" style="height: 100%">
            <div class="col-4">
                <HxSelect TItem="IDocumentGenerator<TInputType>"
                          TValue="IDocumentGenerator<TInputType>"
                          Label="Document Template"
                          TextSelector="t => t.Template.Name"
                          ValueSelector="t => t"
                          Data="Templates"
                          @bind-Value:get="_selectedGenerator"
                          @bind-Value:set="OnSelectedGeneratorChanged"
                          Nullable="true"
                          NullText="- select a template -"
                          NullDataText="Loading templates..." />
                <p>Only document templates which are compatible with the currently selected data are shown.</p>

                <HxButton Text="Generate" Color="ThemeColor.Primary" OnClick="ModalBtnGenerateOnClick" />
                
                <HxCheckbox @bind-Value="_showCollectedValues" Text="Show collected values (debug)" CssClass="small text-muted" />
                @if (_showCollectedValues && _lastCollectedValues != null)
                {
                    <pre class="small bg-light border rounded p-2 mb-2" style="max-height: 160px; overflow: auto;">@PrettyPrintJson(_lastCollectedValues)</pre>
                }

                @if (HasInputForm)
                {
                    <InputFormIframeComponent @ref="_inputForm"
                                              FormHtml="@_inputFormTemplate!.InputFormHtml"
                                              ContextJson="@_formContextJson"
                                              OnReady="() => { _formError = null; StateHasChanged(); }"
                                              OnError="error => { _formError = error; StateHasChanged(); }" />
                    <p class="text-muted small">Switching templates discards entered form values.</p>
                }

                @if (_contextBuildError != null)
                {
                    <div class="text-danger small">Failed to prepare the input form: @_contextBuildError</div>
                }

                @if (_formError != null)
                {
                    <div class="text-danger small">@_formError</div>
                }
            </div>
            <div class="col">
                @if (_cachedOutputDocId == null)
                {
                    <p>Generate the document to show a preview.</p>
                }
                else
                {
                    <embed src="@($"/tmp/{_cachedOutputDocId}")" type="application/pdf" width="100%" height="100%" />
                }
            </div>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Text="Save generated document" Color="ThemeColor.Primary" OnClick="ModalBtnSaveGeneratedDocumentOnClick" />
        <HxButton Text="Cancel" OnClick="async () => await _documentGenerationModal.HideAsync()" Color="ThemeColor.Primary" Outline="true" />
    </FooterTemplate>
</HxModal>