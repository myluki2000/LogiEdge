@page "/document-generator/templates/"
@using System.Reflection
@using Havit.Blazor.Components.Web.Bootstrap
@using LogiEdge.Service.DocumentGenerator.Data
@using LogiEdge.Service.DocumentGenerator.Dto
@using LogiEdge.Service.DocumentGenerator.DocumentGeneration
@using LogiEdge.Service.DocumentGenerator.Services
@using LogiEdge.Shared
@using LogiEdge.WebUI.DocumentGenerator.Components

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject DocumentGenerationService DocumentGenerationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IHxMessageBoxService MessageBox

@code {
    private List<DocumentGenerationTemplateDto> _documentTemplates = [];

    private List<Type> _inputTypesOfDocumentGeneratorComponent = [];

    private HxModal _modalCreateTemplate = null!;

    private HxModal _modalImportTemplate = null!;

    private IJSObjectReference? _templateExportJs;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _documentTemplates = (await DocumentGenerationService.GetTemplates()).ToList();
        _inputTypesOfDocumentGeneratorComponent = GetAllInputTypesOfDocumentGeneratorComponent().ToList();
    }

    private async Task BtnNewTemplateOnClick()
    {
        await _modalCreateTemplate.ShowAsync();
    }

    private async Task BtnImportTemplateOnClick()
    {
        _importError = null;
        await _modalImportTemplate.ShowAsync();
    }

    private async Task BtnExportTemplateOnClick(DocumentGenerationTemplateDto template)
    {
        try
        {
            byte[] zipBytes = await DocumentGenerationService.ExportTemplateAsync(template.Id);

            IJSObjectReference jsModule = _templateExportJs ??=
                await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/_content/LogiEdge.WebUI.DocumentGenerator/js/templateExport.js");
            await jsModule.InvokeVoidAsync("downloadFile", Convert.ToBase64String(zipBytes), $"{SanitizeFileName(template.Name)}.zip", "application/zip");
        }
        catch (Exception exception)
        {
            await MessageBox.ShowAsync("Export Template", $"Failed to export template: {exception.Message}");
        }
    }

    private static string SanitizeFileName(string name)
    {
        char[] invalidCharacters = ['\\', '/', ':', '*', '?', '"', '<', '>', '|'];
        return new string(name.Select(c => invalidCharacters.Contains(c) ? '_' : c).ToArray());
    }

    private static IEnumerable<Type> GetAllInputTypesOfDocumentGeneratorComponent()
    {
        return AppDomain.CurrentDomain.GetAssemblies()
            .SelectMany(a =>
            {
                try { return a.GetTypes(); }
                catch { return []; }
            })
            .Where(t => t is { IsClass: true, IsAbstract: false }
                        && typeof(IDocumentGeneratorInput).IsAssignableFrom(t));
    }
}


<h3>Document Templates</h3>

<HxButton Text="New Template" OnClick="BtnNewTemplateOnClick" Color="ThemeColor.Primary" Icon="@BootstrapIcon.Plus" />
<HxButton Text="Import Template" OnClick="BtnImportTemplateOnClick" Color="ThemeColor.Primary" Icon="@BootstrapIcon.Upload" />

<div class="m-3">
    <table class="table">
        <thead>
        <tr class="table-primary">
            <th>Template Name</th>
            <th>For Data Type</th>
            <th>Template Type</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (DocumentGenerationTemplateDto template in _documentTemplates)
        {
            <tr>
                <td>@template.Name</td>
                <td>@template.InputTypeName</td>
                <td>@template.GetType().Name</td>
                <td>
                    <HxButton Icon="BootstrapIcon.Download"
                              Outline="true"
                              Color="ThemeColor.Primary"
                              Size="ButtonSize.Small"
                              OnClick="@(() => BtnExportTemplateOnClick(template))"/>
                    <HxButton Icon="BootstrapIcon.PencilSquare"
                              Outline="true"
                              Color="ThemeColor.Primary"
                              Size="ButtonSize.Small"
                              OnClick="@(() => NavigationManager.NavigateTo(RouteTo<TemplatePage>("TemplateId", template.Id)))"/>
                    <HxButton Icon="BootstrapIcon.Trash" Outline="true" Color="ThemeColor.Danger" Size="ButtonSize.Small" />
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<HxModal Title="Create New Template" @ref="_modalCreateTemplate">
@code
{
    private Type? _selectedInputType = null;
    private string _templateName = "Untitled template";

    private async Task ModalCreateTemplateBtnCreateOnClick()
    {
        if (_selectedInputType == null)
            return;

        var method = DocumentGenerationService.GetType()
            .GetMethod(nameof(DocumentGenerationService.CreateTemplateForType))
            ?.MakeGenericMethod(typeof(HtmlDocumentGenerationTemplate), _selectedInputType);

        if (method != null)
        {
            await (Task<DocumentGenerationTemplateDto>)method.Invoke(DocumentGenerationService, [_templateName])!;
        }

        _documentTemplates = (await DocumentGenerationService.GetTemplates()).ToList();
        await _modalCreateTemplate.HideAsync();
    }

    private async Task ModalCreateTemplateBtnCancelOnClick()
    {

    }
}
<BodyTemplate>
    <HxInputText Label="Template Name" @bind-Value="_templateName" />
    <HxSelect TItem="Type"
              TValue="Type?"
              @bind-Value="_selectedInputType" Data="_inputTypesOfDocumentGeneratorComponent"
              Label="Input Data"
              TextSelector="t => t.FullName"
              Nullable="true"
              NullText="- select input data type -"
              NullDataText="Loading types..." />
</BodyTemplate>
<FooterTemplate>
    <HxButton Text="Create" OnClick="ModalCreateTemplateBtnCreateOnClick" />
    <HxButton Text="Cancel" OnClick="ModalCreateTemplateBtnCancelOnClick" />
</FooterTemplate>
</HxModal>

<HxModal Title="Import Template" @ref="_modalImportTemplate">
@code
{
    private IBrowserFile? _importFile;
    private string _importTemplateName = "Untitled template";
    private Type? _importSelectedInputType;
    private string? _importError;

    private void ImportFileOnChange(InputFileChangeEventArgs e)
    {
        _importFile = e.File;
        _importError = null;
    }

    private async Task ModalImportTemplateBtnImportOnClick()
    {
        _importError = null;

        if (_importFile == null || _importSelectedInputType == null)
            return;

        try
        {
            byte[] zipData;
            await using Stream stream = _importFile.OpenReadStream(5 * 1024 * 1024);
            using MemoryStream memoryStream = new();
            await stream.CopyToAsync(memoryStream);
            zipData = memoryStream.ToArray();

            await DocumentGenerationService.ImportTemplate(_importTemplateName, _importSelectedInputType, zipData);

            _documentTemplates = (await DocumentGenerationService.GetTemplates()).ToList();
            await _modalImportTemplate.HideAsync();
        }
        catch (Exception exception)
        {
            _importError = exception.Message;
        }
    }

    private async Task ModalImportTemplateBtnCancelOnClick()
    {
        await _modalImportTemplate.HideAsync();
    }
}
<BodyTemplate>
    <InputFile OnChange="ImportFileOnChange" accept=".zip" />
    @if (_importFile != null)
    {
        <div class="mb-2">Selected file: @_importFile.Name</div>
    }
    <HxInputText Label="Template Name" @bind-Value="_importTemplateName" />
    <HxSelect TItem="Type"
              TValue="Type?"
              @bind-Value="_importSelectedInputType" Data="_inputTypesOfDocumentGeneratorComponent"
              Label="Input Data"
              TextSelector="t => t.FullName"
              Nullable="true"
              NullText="- select input data type -"
              NullDataText="Loading types..." />
    <div class="mb-2">The zip must contain body.html; optionally header.html, footer.html and input-form.html.</div>
    @if (_importError != null)
    {
        <div class="text-danger">@_importError</div>
    }
</BodyTemplate>
<FooterTemplate>
    <HxButton Text="Import" OnClick="ModalImportTemplateBtnImportOnClick" />
    <HxButton Text="Cancel" OnClick="ModalImportTemplateBtnCancelOnClick" />
</FooterTemplate>
</HxModal>
