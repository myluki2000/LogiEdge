@page "/customers/create"

@using LogiEdge.CustomerService.Dto
@using LogiEdge.CustomerService.Services
@using LogiEdge.WebUI.Shared.Shared
@using System.Text.RegularExpressions

@inject CustomerManagementService CustomerService
@inject NavigationManager NavManager

@code {
    private string _name = string.Empty;
    private string _abbreviation = string.Empty;
    private string? _feedbackError;

    private async Task CreateNewCustomerAsync()
    {
        _feedbackError = null;

        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_abbreviation))
        {
            _feedbackError = "Customer needs to have both an abbreviation and a name!";
            return;
        }

        string trimmedName = _name.Trim();
        string trimmedAbbreviation = _abbreviation.Trim();

        if (!Regex.IsMatch(trimmedAbbreviation, @"^[A-Z]+$"))
        {
            _feedbackError = "Abbreviation must only contain uppercase letters!";
            return;
        }

        if (await CustomerService.GetCustomerByAbbreviation(trimmedAbbreviation) != null)
        {
            _feedbackError = "A customer with the specified abbreviation already exists! Abbreviations must be unique!";
            return;
        }

        CustomerDto created = await CustomerService.CreateCustomer(trimmedName, trimmedAbbreviation);
        NavManager.NavigateToRoute<CustomerPage>(new Dictionary<string, object> { ["Id"] = created.Id });
    }
}

<div class="create-customer-page">
    <div class="create-customer-page-header d-flex align-items-center flex-wrap gap-3">
        <button type="button" class="create-customer-back-btn" title="Back to customers" aria-label="Back to customers" @onclick="@(() => NavManager.NavigateToRoute<CustomersPage>())">
            <span class="material-symbols-rounded">arrow_back</span>
        </button>
        <h3 class="create-customer-page-title mb-0">New Customer</h3>
    </div>

    <div class="card create-customer-card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    <HxInputText @bind-Value="_name" Placeholder="e.g. Acme GmbH" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Abbreviation</label>
                    <HxInputText @bind-Value="_abbreviation" Placeholder="e.g. ACM" />
                    <div class="form-text">Uppercase letters only (A–Z). Must be unique.</div>
                </div>
            </div>

            @if (_feedbackError != null)
            {
                <div class="alert alert-danger create-customer-feedback mt-3" role="alert">@_feedbackError</div>
            }

            <div class="d-flex gap-2 create-customer-form-actions">
                <HxButton Color="ThemeColor.Primary" OnClick="CreateNewCustomerAsync">
                    <span class="material-symbols-rounded create-customer-btn-icon" aria-hidden="true">person_add</span>Create Customer
                </HxButton>
                <HxButton Color="ThemeColor.Secondary" OnClick="@(() => NavManager.NavigateToRoute<CustomersPage>())">Cancel</HxButton>
            </div>
        </div>
    </div>
</div>
