@page "/customers/create"

@using LogiEdge.CustomerService.Dto
@using LogiEdge.CustomerService.Services
@using LogiEdge.WebUI.Shared.Shared
@using System.Text.RegularExpressions

@inject CustomerManagementService CustomerService
@inject NavigationManager NavManager

@code {
    private string _canonicalName = string.Empty;
    private string _shortName = string.Empty;
    private string _abbreviation = string.Empty;

    // Optional billing address.
    private string _billingLabel = string.Empty;
    private string _billingStreet = string.Empty;
    private string _billingHouseNumber = string.Empty;
    private string _billingZipCode = string.Empty;
    private string _billingCity = string.Empty;
    private string _billingCountry = string.Empty;

    private string? _feedbackError;

    private async Task CreateNewCustomerAsync()
    {
        _feedbackError = null;

        if (string.IsNullOrWhiteSpace(_canonicalName) || string.IsNullOrWhiteSpace(_shortName) || string.IsNullOrWhiteSpace(_abbreviation))
        {
            _feedbackError = "Customer needs to have a canonical name, a short name and an abbreviation!";
            return;
        }

        string trimmedCanonicalName = _canonicalName.Trim();
        string trimmedShortName = _shortName.Trim();
        string trimmedAbbreviation = _abbreviation.Trim();

        if (!Regex.IsMatch(trimmedAbbreviation, @"^[A-Z]+$"))
        {
            _feedbackError = "Abbreviation must only contain uppercase letters!";
            return;
        }

        if (await CustomerService.GetCustomerByAbbreviation(trimmedAbbreviation) != null)
        {
            _feedbackError = "A customer with the specified abbreviation already exists! Abbreviations must be unique!";
            return;
        }

        bool hasStreet = !string.IsNullOrWhiteSpace(_billingStreet);
        if (hasStreet && (string.IsNullOrWhiteSpace(_billingZipCode) || string.IsNullOrWhiteSpace(_billingCity) || string.IsNullOrWhiteSpace(_billingCountry)))
        {
            _feedbackError = "A billing address with a street also needs a zip code, city and country!";
            return;
        }

        AddressDto? billingAddress = hasStreet
            ? new AddressDto
            {
                Label = string.IsNullOrWhiteSpace(_billingLabel) ? null : _billingLabel.Trim(),
                Street = _billingStreet.Trim(),
                HouseNumber = string.IsNullOrWhiteSpace(_billingHouseNumber) ? null : _billingHouseNumber.Trim(),
                ZipCode = _billingZipCode.Trim(),
                City = _billingCity.Trim(),
                Country = _billingCountry.Trim(),
            }
            : null;

        CustomerDto created = await CustomerService.CreateCustomer(trimmedCanonicalName, trimmedShortName, trimmedAbbreviation, billingAddress);
        NavManager.NavigateToRoute<CustomerPage>(new Dictionary<string, object> { ["Id"] = created.Id });
    }
}

<div class="create-customer-page">
    <div class="create-customer-page-header d-flex align-items-center flex-wrap gap-3">
        <button type="button" class="create-customer-back-btn" title="Back to customers" aria-label="Back to customers" @onclick="@(() => NavManager.NavigateToRoute<CustomersPage>())">
            <span class="material-symbols-rounded">arrow_back</span>
        </button>
        <h3 class="create-customer-page-title mb-0">New Customer</h3>
    </div>

    <div class="card create-customer-card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Canonical name</label>
                    <HxInputText @bind-Value="_canonicalName" Placeholder="e.g. Acme Trading Co. GmbH" />
                    <div class="form-text">Full legal company name.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Short name</label>
                    <HxInputText @bind-Value="_shortName" Placeholder="e.g. Acme Trading" />
                    <div class="form-text">Display name without legal suffixes.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Abbreviation</label>
                    <HxInputText @bind-Value="_abbreviation" Placeholder="e.g. ACM" />
                    <div class="form-text">Uppercase letters only (A–Z). Must be unique.</div>
                </div>
            </div>

            <hr class="create-customer-divider" />

            <h6 class="create-customer-section-title">Billing address (optional)</h6>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Label</label>
                    <HxInputText @bind-Value="_billingLabel" Placeholder="e.g. HQ" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Street</label>
                    <HxInputText @bind-Value="_billingStreet" Placeholder="e.g. Industriestraße" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">House number</label>
                    <HxInputText @bind-Value="_billingHouseNumber" Placeholder="e.g. 12" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Zip code</label>
                    <HxInputText @bind-Value="_billingZipCode" Placeholder="e.g. 10115" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">City</label>
                    <HxInputText @bind-Value="_billingCity" Placeholder="e.g. Berlin" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Country</label>
                    <HxInputText @bind-Value="_billingCountry" Placeholder="e.g. Germany" />
                </div>
            </div>

            @if (_feedbackError != null)
            {
                <div class="alert alert-danger create-customer-feedback mt-3" role="alert">@_feedbackError</div>
            }

            <div class="d-flex gap-2 create-customer-form-actions">
                <HxButton Color="ThemeColor.Primary" OnClick="CreateNewCustomerAsync">
                    <span class="material-symbols-rounded create-customer-btn-icon" aria-hidden="true">person_add</span>Create Customer
                </HxButton>
                <HxButton Color="ThemeColor.Secondary" OnClick="@(() => NavManager.NavigateToRoute<CustomersPage>())">Cancel</HxButton>
            </div>
        </div>
    </div>
</div>
