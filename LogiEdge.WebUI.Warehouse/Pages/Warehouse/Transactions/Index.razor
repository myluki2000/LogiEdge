@page "/warehouse/transactions/"
@using System.Security.Claims
@using LogiEdge.WarehouseService.Data.Transactions
@using LogiEdge.WarehouseService.Dto
@using LogiEdge.WarehouseService.Services.WarehouseManagement
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject TransactionManagementService TransactionService
@inject NavigationManager NavigationManager

@code {
    private List<InventoryTransactionBaseInfoDto> _transactions = [];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        _transactions = await TransactionService.GetTransactionsAsync();
    }

    private async Task BtnCreateTransactionOnClick()
    {
        Guid newTransactionId = await TransactionService.CreateTransaction(string.Empty);
        NavigationManager.NavigateTo(RouteTo<TransactionPage>("TransactionId", newTransactionId));
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Transactions</h3>
    <HxButton Text="New Transaction" Icon="@BootstrapIcon.Plus" Color="ThemeColor.Primary" OnClick="BtnCreateTransactionOnClick" />
</div>

@if (_transactions.Count == 0)
{
    <div class="text-center text-muted py-5">
        No transactions yet. Use <strong>New Transaction</strong> to create the first one.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (InventoryTransactionBaseInfoDto transaction in _transactions)
        {
            <div class="col">
                <NavLink class="transaction-card card h-100" href="@(RouteTo<TransactionPage>("TransactionId", transaction.Id))">
                    <div class="card-body d-flex flex-column p-3">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <h5 class="card-title mb-0 text-truncate">@transaction.Title</h5>
                            @if (transaction.State == TransactionState.DRAFT)
                            {
                                <HxBadge Color="ThemeColor.Secondary" Type="BadgeType.RoundedPill">Draft</HxBadge>
                            }
                            else
                            {
                                <HxBadge Color="ThemeColor.Success" Type="BadgeType.RoundedPill">Booked</HxBadge>
                            }
                        </div>

                        <small class="text-muted mt-2">Created @transaction.CreatedDate</small>
                        @if (transaction.BookedDate != null)
                        {
                            <small class="text-muted">Booked @transaction.BookedDate</small>
                        }

                        <div class="mt-auto pt-3 d-flex flex-wrap gap-1 align-items-center">
                            @if (!transaction.HasInboundPart && !transaction.HasOutboundPart && !transaction.HasRelocationPart)
                            {
                                <span class="text-muted small">No parts yet</span>
                            }
                            else
                            {
                                @if (transaction.HasInboundPart)
                                {
                                    <HxBadge Color="ThemeColor.Info" Type="BadgeType.RoundedPill">Inbound</HxBadge>
                                }
                                @if (transaction.HasOutboundPart)
                                {
                                    <HxBadge Color="ThemeColor.Warning" Type="BadgeType.RoundedPill">Outbound</HxBadge>
                                }
                                @if (transaction.HasRelocationPart)
                                {
                                    <HxBadge Color="ThemeColor.Secondary" Type="BadgeType.RoundedPill">Relocation</HxBadge>
                                }
                            }
                        </div>
                    </div>
                </NavLink>
            </div>
        }
    </div>
}
