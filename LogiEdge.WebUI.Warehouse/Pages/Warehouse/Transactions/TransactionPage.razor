@page "/warehouse/transactions/{TransactionId:guid}"
@using LogiEdge.WarehouseService.Data.Transactions
@using LogiEdge.WarehouseService.Dto
@using LogiEdge.WarehouseService.Services.WarehouseManagement
@using LogiEdge.WebUI.Shared.Components
@using LogiEdge.WebUI.Shared.Shared
@using LogiEdge.WebUI.Warehouse.Components
@using LogiEdge.WebUI.Warehouse.Components.Transaction
@using Microsoft.AspNetCore.Components.Forms
@using LogiEdge.WebUI.Warehouse.Components.Transaction.Inbound
@using LogiEdge.WebUI.Warehouse.Components.Transaction.Outbound


@inject TransactionManagementService TransactionService

@code {
    /// <summary>
    /// The ID of the transaction this page will show
    /// </summary>
    [Parameter]
    public Guid TransactionId { get; set; }

    [CascadingParameter]
    public required MainLayout Layout { get; set; }

    private InventoryTransactionBaseInfoDto? _transaction { get; set; }
    private bool _initialLoadComplete = false;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await ReloadTransactionAsync();
    }

    private async Task ReloadTransactionAsync()
    {
        _initialLoadComplete = false;
        _transaction = await TransactionService.GetTransactionBaseInfo(TransactionId);
        _initialLoadComplete = true;

        StateHasChanged();
    }
}

@{
    Layout?.SetPadding(false);

    if (!_initialLoadComplete)
    {
        <HxSpinner />
        return;
    }
    if (_transaction == null)
    {
        <p>Transaction with ID @TransactionId could not be found.</p>
        return;
    }

    <div class="tx-page">
        @if (_transaction.State == TransactionState.DRAFT)
        {
            // TODO: If we pass Transaction instead of TransactionId, we don't have to reload the transaction after booking
            <DraftTransactionComponent TransactionId="TransactionId" OnTransactionBooked="ReloadTransactionAsync" />
        }
        else if (_transaction.State == TransactionState.BOOKED)
        {
            <BookedTransactionComponent TransactionId="TransactionId" />
        }
        else
        {
            <p>Unknown transaction state encountered: @_transaction.State</p>
        }
    </div>
}
