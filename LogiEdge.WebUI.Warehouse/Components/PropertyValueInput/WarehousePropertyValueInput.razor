@using LogiEdge.WarehouseService.Dto
@using LogiEdge.WarehouseService.Services.WarehouseManagement
@using Microsoft.AspNetCore.Components.Forms
@inject WarehouseManagementService WarehouseService

@code {
    [Parameter]
    public required WarehouseBaseInfoDto? Value { get; set; }
    [Parameter]
    public EventCallback<WarehouseBaseInfoDto?> ValueChanged { get; set; }

    private List<WarehouseBaseInfoDto> _warehouses = [];

    private Guid SelectedWarehouseId
    {
        get => Value?.Id ?? Guid.Empty;
        set
        {
            WarehouseBaseInfoDto? selectedWarehouse = _warehouses.Find(w => w.Id == value);
            if (selectedWarehouse != Value)
            {
                Value = selectedWarehouse;
                ValueChanged.InvokeAsync(Value);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _warehouses = await WarehouseService.GetWarehouses();
        await base.OnInitializedAsync();
    }

}

<InputSelect TValue="Guid"
             @bind-Value="SelectedWarehouseId"
             class="form-select w-auto"
             style="display: inline;">
    <option value="@Guid.Empty"> </option>
    @foreach (WarehouseBaseInfoDto warehouse in _warehouses.OrderBy(w => w.Name.ToUpper()))
    {
        <option value="@warehouse.Id">@warehouse.Name</option>
    }
</InputSelect>
