@using System.Reflection
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.ComponentModel.DataAnnotations
@using LogiEdge.WarehouseService.Data
@using LogiEdge.WarehouseService.Data.Transactions
@using LogiEdge.WarehouseService.Dto

@code {
    [Parameter]
    public required string PropertyName { get; set; }
    [Parameter]
    public required InboundTransactionPartDto.InboundDraftItemDto DraftItem { get; set; }
    [Parameter]
    public EventCallback<PropertyValueChangedEventArgs> PropertyValueChanged { get; set; }
    [Parameter]
    public int? TabIndex { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool LastInputInvalid { get; set; }
    [Parameter]
    public EventCallback<bool> LastInputInvalidChanged { get; set; }

    private DraftPropertyValueInput draftPropertyValueInput;

    private object? GetPropertyValue()
    {
        PropertyInfo? pi = DraftItem.GetType().GetProperty(PropertyName);
        Type? propertyType = GetPropertyType();

        if (pi == null)
        {
            return DraftItem.AdditionalProperties.FirstOrDefault(p => p.Name == PropertyName)?.Value;
        }

        return pi.GetValue(DraftItem);
    }

    private void SetPropertyValue(object? value)
    {
        PropertyInfo? pi = DraftItem.GetType().GetProperty(PropertyName);
        if (pi != null)
        {
            object? oldValue = pi.GetValue(DraftItem);
            if (!value?.Equals(oldValue) ?? oldValue != null)
            {
                pi.SetValue(DraftItem, value);
                PropertyValueChanged.InvokeAsync(new PropertyValueChangedEventArgs()
                {
                    PropertyName = PropertyName,
                    NewValue = value
                });
            }
        }
        else
        {
            ItemAdditionalPropertyDto? additionalProperty = DraftItem.AdditionalProperties.FirstOrDefault(p => p.Name == PropertyName);
            if (additionalProperty != null && additionalProperty.Value != value)
            {
                additionalProperty.Value = value;
                PropertyValueChanged.InvokeAsync(new PropertyValueChangedEventArgs()
                {
                    PropertyName = PropertyName,
                    NewValue = value
                });
            }
        }
    }

    private Type GetPropertyType()
    {
        PropertyInfo? pi = DraftItem.GetType().GetProperty(PropertyName);
        Type? propertyType = pi?.PropertyType
                             ?? DraftItem.AdditionalProperties.FirstOrDefault(x => x.Name == PropertyName)?.Type.ToType();

        if(propertyType == null)
            throw new InvalidOperationException($"Property '{PropertyName}' not found in {DraftItem.GetType().Name} or ItemSchema.");

        return propertyType;
    }

    private (int? min, int? max) GetNumericRange()
    {
        PropertyInfo? pi = DraftItem.GetType().GetProperty(PropertyName);
        if (pi?.GetCustomAttribute<RangeAttribute>() is { Minimum: int min, Maximum: int max })
            return (min, max);

        return (null, null);
    }

    private void DraftPropertyValueInputOnInput(DraftPropertyValueInput.DraftPropertyValueInputEventArgs e)
    { 
        LastInputInvalid = !e.IsValid;

        if (e.IsValid)
            SetPropertyValue(e.Value);

        LastInputInvalidChanged.InvokeAsync(LastInputInvalid);
    }

    public async Task FocusAsync()
    {
        await draftPropertyValueInput.FocusAsync();
    }

    public class PropertyValueChangedEventArgs : EventArgs
    {
        public required string PropertyName { get; set; }
        public required object? NewValue { get; set; }
    }
}

<DraftPropertyValueInput 
    @ref="draftPropertyValueInput"
    Value="GetPropertyValue()"
    OnInput="DraftPropertyValueInputOnInput"
    ValueType="GetPropertyType()"
    Min="@GetNumericRange().min"
    Max="@GetNumericRange().max"
    TabIndex="TabIndex"
    Placeholder="@Placeholder" />
