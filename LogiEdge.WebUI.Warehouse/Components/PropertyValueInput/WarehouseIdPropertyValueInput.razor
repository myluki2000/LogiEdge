@using LogiEdge.WarehouseService.Dto
@using LogiEdge.WarehouseService.Services.WarehouseManagement
@using Microsoft.AspNetCore.Components.Forms
@inject WarehouseManagementService WarehouseService

@code {
    [Parameter]
    public required Guid Value { get; set; }
    [Parameter]
    public EventCallback<Guid> ValueChanged { get; set; }

    private List<WarehouseBaseInfoDto> _warehouses = [];

    protected override async Task OnInitializedAsync()
    {
        _warehouses = await WarehouseService.GetWarehouses();
        await base.OnInitializedAsync();
    }

}

<InputSelect TValue="Guid"
             Value="Value"
             ValueChanged="ValueChanged"
             class="form-select"
             @onclick:stopPropagation="true">
    <option value="@Guid.Empty"> </option>
    @foreach (WarehouseBaseInfoDto warehouse in _warehouses.OrderBy(w => w.Name.ToUpper()))
    {
        <option value="@warehouse.Id">@warehouse.Name</option>
    }
</InputSelect>
