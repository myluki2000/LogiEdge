@using LogiEdge.WarehouseService.Dto
@using LogiEdge.WarehouseService.Services.WarehouseManagement
@using LogiEdge.WebUI.Warehouse.Components.PropertyValueInput
@using Microsoft.AspNetCore.Components.Forms

@inject WarehouseManagementService WarehouseService

@code
{
    [Parameter]
    public required Guid? CustomerId { get; set; }
    [Parameter]
    public EventCallback<Guid?> CustomerIdChanged { get; set; }
    [Parameter]
    public required Guid? ItemSchemaId { get; set; }
    [Parameter]
    public EventCallback<Guid?> ItemSchemaIdChanged { get; set; }

    private List<ItemSchemaDto> ItemSchemas { get; set; } = [];

    private Guid SelectedCustomerId
    {
        get => CustomerId ?? Guid.Empty;
        set
        {
            Guid? customerId = value == Guid.Empty ? null : value;
            if (customerId != CustomerId)
            {
                CustomerId = customerId;
                CustomerIdChanged.InvokeAsync(customerId);
            }

            ItemSchemaDto? selectedSchema = ItemSchemas.FirstOrDefault(s => s.Id == ItemSchemaId);
            if (selectedSchema != null &&
                (customerId == null || !selectedSchema.CustomerIds.Contains(customerId.Value)))
            {
                ItemSchemaId = null;
                ItemSchemaIdChanged.InvokeAsync(null);
            }
        }
    }

    private async Task OnItemSchemaSelected(Guid? schemaId)
    {
        if (schemaId != ItemSchemaId)
        {
            ItemSchemaId = schemaId;
            await ItemSchemaIdChanged.InvokeAsync(schemaId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ItemSchemas = await WarehouseService.GetItemSchemas();

        await base.OnInitializedAsync();
    }
}


<div class="d-flex align-items-center gap-2">
    <label for="customerToAdd" class="col-form-label text-nowrap">Customer:</label>
    <CustomerIdPropertyValueInput Value="SelectedCustomerId"
                                  ValueChanged="value => SelectedCustomerId = value"
                                  Class="flex-fill"
                                  id="customerToAdd" />
</div>
<div class="d-flex align-items-center gap-2">
    <label for="schemaToAdd" class="col-form-label text-nowrap">Item&nbsp;Schema:</label>
    <InputSelect TValue="Guid?" @bind-Value:get="ItemSchemaId" @bind-Value:set="v => OnItemSchemaSelected(v)" Class="form-select flex-fill" id="schemaToAdd">
        <option value="@((Guid?)null)"></option>
        @foreach (ItemSchemaDto schema in ItemSchemas.Where(sch => CustomerId == null || sch.CustomerIds.Contains(CustomerId.Value)))
        {
            <option value="@schema.Id">@schema.Name</option>
        }
    </InputSelect>
</div>
