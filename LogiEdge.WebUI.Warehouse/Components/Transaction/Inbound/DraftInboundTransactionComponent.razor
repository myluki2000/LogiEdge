@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using System.Text.RegularExpressions
@using LogiEdge.CustomerService.Data
@using LogiEdge.CustomerService.Dto
@using LogiEdge.CustomerService.Services
@using LogiEdge.Shared.Attributes
@using LogiEdge.WebUI.Warehouse.Components.PropertyValueInput
@using LogiEdge.WarehouseService.Data
@using LogiEdge.WarehouseService.Data.Transactions
@using LogiEdge.WarehouseService.Dto
@using LogiEdge.WarehouseService.Services.WarehouseManagement
@using LogiEdge.WebUI.Shared.Components

@inject TransactionManagementService TransactionService
@inject WarehouseManagementService WarehouseService
@inject CustomerManagementService CustomerService

@code {
    [Parameter]
    public required Guid TransactionId { get; set; }
    [Parameter]
    public required DebouncerComponent Debouncer { get; set; }

    private InboundTransactionPartDto _inboundPart = null!;
    private Guid? SelectedCustomerToAdd { get; set; }
    private Guid? SelectedItemSchemaToAdd { get; set; }
    private List<(WarehouseBaseInfoDto warehouse, CustomerDto customer, ItemSchemaDto schema)> ItemSchemasToShow { get; set; } = [];

    private Dictionary<Guid, CustomerDto> _customerCache = new();
    private Dictionary<Guid, ItemSchemaDto> _itemSchemaCache = new();
    private Dictionary<Guid, WarehouseBaseInfoDto> _warehouseCache = new();

    private List<WarehouseBaseInfoDto> _warehouses = [];
    private Guid? _modalSelectedWarehouseId = null;

    private HxModal _addItemListModal = null!;

    /// <summary>
    /// Dictionary to hold property values for the "new items", i.e. the ghost row at the bottom of each item list table
    /// </summary>
    private Dictionary<(Guid customer, Guid itemSchema), Dictionary<string, object?>> NewItems { get; set; } = new();


    [Parameter]
    public bool IsAnyInputInvalid { get; set; }

    [Parameter]
    public EventCallback<bool> IsAnyInputInvalidChanged { get; set; }

    private Dictionary<(Guid item, string property), bool> LastInputInvalidMap { get; set; } = new();

    private void UpdateInputInvalidState(Guid itemId, string propertyName, bool isInvalid)
    {
        LastInputInvalidMap[(itemId, propertyName)] = isInvalid;
        RefreshAnyInputInvalidState();
    }

    private void RefreshAnyInputInvalidState()
    {
        bool anyInvalid = LastInputInvalidMap.Values.Any(v => v);
        if (IsAnyInputInvalid != anyInvalid)
        {
            IsAnyInputInvalid = anyInvalid;
            IsAnyInputInvalidChanged.InvokeAsync(anyInvalid);
        }
    }

    private Dictionary<(Guid customer, Guid itemSchema, string propertyName), DraftPropertyValueInput> lastItemInputComponents = [];
    private Dictionary<(Guid customer, Guid itemSchema, string propertyName), DraftPropertyValueInput> newItemRowInputComponents = [];
    private (Guid customer, Guid itemSchema, string propertyName)? focusOnLastElement = null;
    private (Guid customer, Guid itemSchema, string propertyName)? focusOnNewItemRow = null;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ReloadInboundPartAsync();

        _warehouses = await WarehouseService.GetWarehouses();
        if (_modalSelectedWarehouseId == null)
        {
            WarehouseBaseInfoDto? firstWarehouse = _warehouses.FirstOrDefault();
            if (firstWarehouse != null)
                _modalSelectedWarehouseId = firstWarehouse.Id;
        }
    }

    private async Task ReloadInboundPartAsync()
    {
        _inboundPart = await TransactionService.GetInboundTransactionPart(TransactionId);

        // use group by id instead of .Distinct() because with .NoTracking(), it doesn't reuse the same instance for Customer, Warehouse etc.
        ItemSchemasToShow = (await Task.WhenAll(
            _inboundPart.DraftItems
                .GroupBy(it => (it.WarehouseId, it.CustomerId, it.ItemSchemaId))
                .Select(async g =>
                {
                    InboundTransactionPartDto.InboundDraftItemDto item = g.First();

                    return (
                        warehouse: (await GetWarehouseFromCache(item.WarehouseId))!,
                        customer: (await GetCustomerFromCache(item.CustomerId))!,
                        schema: await GetItemSchemaFromCache(item.ItemSchemaId)
                    );
                })
        )).ToList();
    }

    private async Task<CustomerDto?> GetCustomerFromCache(Guid customerId)
    {
        if (!_customerCache.TryGetValue(customerId, out CustomerDto? customer)) 
        {
            customer = await CustomerService.GetCustomerByIdAsync(customerId);
            if (customer != null)
            {
                _customerCache[customerId] = customer;
            }
        }
        return customer ?? null;
    }

    private async Task<WarehouseBaseInfoDto?> GetWarehouseFromCache(Guid warehouseId)
    {
        if (!_warehouseCache.TryGetValue(warehouseId, out WarehouseBaseInfoDto? warehouse))
        {
            warehouse = await WarehouseService.GetWarehouseById(warehouseId);
            if (warehouse != null)
            {
                _warehouseCache[warehouseId] = warehouse;
            }
        }
        return warehouse ?? null;
    }

    private async Task<ItemSchemaDto> GetItemSchemaFromCache(Guid schemaId)
    {
        if (!_itemSchemaCache.TryGetValue(schemaId, out ItemSchemaDto? schema))
        {
            schema = await WarehouseService.GetItemSchema(schemaId);
            if (schema != null)
            {
                _itemSchemaCache[schemaId] = schema;
            }
        }
        return schema ?? null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusOnLastElement != null && lastItemInputComponents.TryGetValue(focusOnLastElement.Value, out DraftPropertyValueInput? inputComponent))
        {
            await inputComponent.FocusAsync();
        }
        focusOnLastElement = null;

        if (focusOnNewItemRow != null && newItemRowInputComponents.TryGetValue(focusOnNewItemRow.Value, out DraftPropertyValueInput? newItemInputComponent))
        {
            await newItemInputComponent.FocusAsync();
        }
        focusOnNewItemRow = null;

        await base.OnAfterRenderAsync(firstRender);
    }

    private WarehouseBaseInfoDto? GetModalSelectedWarehouse()
        => _warehouses.FirstOrDefault(w => w.Id == _modalSelectedWarehouseId);

    private bool IsAddingExistingItemList
    {
        get
        {
            if (SelectedCustomerToAdd == null || SelectedItemSchemaToAdd == null)
                return false;

            WarehouseBaseInfoDto? warehouse = GetModalSelectedWarehouse();
            if (warehouse == null)
                return false;

            return ItemSchemasToShow.Any(g => g.warehouse.Id == warehouse.Id
                                            && g.customer.Id == SelectedCustomerToAdd.Value
                                            && g.schema.Id == SelectedItemSchemaToAdd.Value);
        }
    }

    private bool CanAddItemList
        => GetModalSelectedWarehouse() != null
           && SelectedCustomerToAdd != null
           && SelectedItemSchemaToAdd != null
           && !IsAddingExistingItemList;

    private async Task ShowAddItemListModalAsync()
    {
        await _addItemListModal.ShowAsync();
    }

    private async Task BtnAddSchemaOnClick()
    {
        if (!CanAddItemList)
            return;

        WarehouseBaseInfoDto warehouse = GetModalSelectedWarehouse()!;
        CustomerDto customer = await GetCustomerFromCache(SelectedCustomerToAdd.Value);
        ItemSchemaDto schema = await GetItemSchemaFromCache(SelectedItemSchemaToAdd.Value);
        ItemSchemasToShow.Add((warehouse, customer, schema));
        FocusNewItemRow(customer, schema);

        // Clear the selections before hiding so that the "already added" error message
        // doesn't flash during the modal's close animation and the next add starts clean.
        // The warehouse selection is kept as a convenience for adding further lists.
        SelectedCustomerToAdd = null;
        SelectedItemSchemaToAdd = null;

        await _addItemListModal.HideAsync();
    }

    private void FocusNewItemRow(CustomerDto customer, ItemSchemaDto schema)
    {
        string firstPropertyName = GetPropertyColumns(schema).First().propertyName;
        focusOnNewItemRow = (customer.Id, schema.Id, firstPropertyName);
        StateHasChanged();
    }

    private List<(string propertyName, Type propertyType)> GetPropertyColumns(ItemSchemaDto schema)
    {
        List<(string propertyName, Type propertyType)> propertyColumns = typeof(InboundDraftItem)
            .GetProperties()
            .Where(p => Attribute.IsDefined(p, typeof(DisplayColumnPropertyAttribute)) &&
                        !Attribute.IsDefined(p, typeof(KeyAttribute)))
            .Select(p => (p.Name, p.PropertyType))
            .ToList();
        propertyColumns.AddRange(schema.AdditionalProperties.Select((x, i) => (x.Name, x.Type)));

        return propertyColumns;
    }

    private object? GetItemPropertyValue(InboundTransactionPartDto.InboundDraftItemDto item, string propertyName)
    {
        if (propertyName == nameof(InboundTransactionPartDto.InboundDraftItemDto.Comments))
            return item.Comments.FirstOrDefault()?.Text;

        PropertyInfo? propertyInfo = typeof(InboundTransactionPartDto.InboundDraftItemDto).GetProperty(propertyName);
        if (propertyInfo != null)
            return propertyInfo.GetValue(item);

        return item.AdditionalProperties.FirstOrDefault(p => p.Name == propertyName)?.Value;
    }

    private void SetItemPropertyValue(InboundTransactionPartDto.InboundDraftItemDto item, string propertyName, object? value)
    {
        if (propertyName == nameof(InboundTransactionPartDto.InboundDraftItemDto.Comments))
        {
            if (item.Comments.Count > 0)
                item.Comments[0].Text = value?.ToString() ?? string.Empty;
            return;
        }

        PropertyInfo? propertyInfo = typeof(InboundTransactionPartDto.InboundDraftItemDto).GetProperty(propertyName);
        if (propertyInfo != null)
        {
            propertyInfo.SetValue(item, value);
            return;
        }

        ItemAdditionalPropertyDto? additionalProperty = item.AdditionalProperties.FirstOrDefault(p => p.Name == propertyName);
        if (additionalProperty != null)
            additionalProperty.Value = value;
    }

    private (int? min, int? max) GetNumericRange(string propertyName)
    {
        if (typeof(InboundDraftItem).GetProperty(propertyName)?.GetCustomAttribute<RangeAttribute>() is { Minimum: int min, Maximum: int max })
            return (min, max);

        return (null, null);
    }

    private void ItemPropertyInputChanged(InboundTransactionPartDto.InboundDraftItemDto item, string propertyName, DraftPropertyValueInput.DraftPropertyValueInputEventArgs e)
    {
        UpdateInputInvalidState(item.Id, propertyName, !e.IsValid);

        if (!e.IsValid || Equals(e.Value, GetItemPropertyValue(item, propertyName)))
            return;

        SetItemPropertyValue(item, propertyName, e.Value);
        Debouncer.Debounce(async Task () => await SaveItemPropertyValueToDatabaseAsync(item.Id, propertyName, e.Value));
    }

    private void NewItemPropertyInputChanged(Guid customerId, Guid itemSchemaId, Guid warehouseId, string propertyName, DraftPropertyValueInput.DraftPropertyValueInputEventArgs e)
    {
        if (!e.IsValid)
            return;

        NewItems[(customerId, itemSchemaId)][propertyName] = e.Value;
        _ = NewItemPropertyValueChanged(customerId, itemSchemaId, warehouseId, propertyName, e.Value);
    }

    private async Task NewItemPropertyValueChanged(Guid customerId, Guid itemSchemaId, Guid warehouseId, string propertyName, object? newValue)
    {
        InboundTransactionPartDto.InboundDraftItemDto saved = await TransactionService.AddInboundDraftItem(TransactionId, customerId, itemSchemaId, warehouseId);

        saved = await TransactionService.UpdateInboundDraftItemPropertyValue(TransactionId, saved.Id, propertyName, newValue);

        _inboundPart.DraftItems.Add(saved);
        NewItems[(customerId, itemSchemaId)].Remove(propertyName);
        focusOnLastElement = (customerId, itemSchemaId, propertyName);
        StateHasChanged();
    }

    private async Task DeleteItem(Guid itemId)
    {
        await TransactionService.DeleteInboundDraftItem(TransactionId, itemId);

        LastInputInvalidMap = LastInputInvalidMap.Where(kvp => kvp.Key.item != itemId).ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
        RefreshAnyInputInvalidState();

        await ReloadInboundPartAsync();
    }

    private async Task DeleteItemList(Guid warehouseId, Guid customerId, Guid schemaId)
    {
        List<Guid> itemIds = _inboundPart.DraftItems
            .Where(it => it.CustomerId == customerId && it.ItemSchemaId == schemaId && it.WarehouseId == warehouseId)
            .Select(it => it.Id)
            .ToList();

        await TransactionService.DeleteInboundDraftItemList(TransactionId, customerId, schemaId, warehouseId);

        NewItems.Remove((customerId, schemaId));

        LastInputInvalidMap = LastInputInvalidMap.Where(kvp => !itemIds.Contains(kvp.Key.item)).ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
        RefreshAnyInputInvalidState();

        await ReloadInboundPartAsync();
    }

    private async Task SaveItemPropertyValueToDatabaseAsync(Guid draftItemId, string propertyName, object? newValue)
    {
        if (_inboundPart.DraftItems.All(di => di.Id != draftItemId))
            return;

        await TransactionService.UpdateInboundDraftItemPropertyValue(TransactionId, draftItemId, propertyName, newValue);
    }
}

@if (ItemSchemasToShow.Count > 0)
{
    <div class="d-flex justify-content-end mb-3">
        <HxButton Text="Add Item List"
                  Icon="@BootstrapIcon.Plus"
                  Color="ThemeColor.Primary"
                  OnClick="ShowAddItemListModalAsync" />
    </div>
}

@if (ItemSchemasToShow.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <span class="material-symbols-rounded empty-state-icon">add_box</span>
            <h6>No inbound items yet</h6>
            <p class="text-muted mb-3">Add an item list to start entering the items that are coming into the warehouse.</p>
            <HxButton Text="Add Item List"
                      Icon="@BootstrapIcon.Plus"
                      Color="ThemeColor.Primary"
                      OnClick="ShowAddItemListModalAsync" />
        </div>
    </div>
}

@foreach ((WarehouseBaseInfoDto warehouse, CustomerDto customer, ItemSchemaDto schema) in ItemSchemasToShow)
{
    List<InboundTransactionPartDto.InboundDraftItemDto> schemaItems = 
        _inboundPart.DraftItems.Where(it => it.CustomerId == customer.Id && it.ItemSchemaId == schema.Id).ToList();
    List<(string propertyName, Type propertyType)> propertyColumns = GetPropertyColumns(schema);

    <div class="card mb-3 draft-items-card">
        <div class="card-header d-flex justify-content-between align-items-center gap-2">
            <div>
                <span class="fw-bold">@schema.Name</span>
                <div class="small text-muted">Customer: @customer.ShortName · Warehouse: @warehouse.Name</div>
            </div>
            <HxButton Color="ThemeColor.Secondary"
                      CssClass="item-list-delete-button"
                      Icon="BootstrapIcon.Trash"
                      Tooltip="Remove this item list and all of its items from the transaction."
                      OnClick="async Task () => await DeleteItemList(warehouse.Id, customer.Id, schema.Id)" />
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0 draft-items-table">
                <thead>
                    <tr>
                        @foreach ((string propertyName, Type propertyType) propertyColumn in propertyColumns)
                        {
                            <th>@(propertyColumn.propertyName)</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int tabIndex = 1;
                        foreach (InboundTransactionPartDto.InboundDraftItemDto item in schemaItems)
                        {
                            <tr>
                                @foreach ((string propertyName, Type propertyType) in propertyColumns)
                                {
                                    bool isCellInvalid = LastInputInvalidMap.TryGetValue((item.Id, propertyName), out bool cellInvalid) && cellInvalid;
                                    <td class="@(isCellInvalid ? "cell-invalid" : null)">
                                        @if (item == schemaItems.Last())
                                        {
                                            <DraftPropertyValueInput
                                                @ref="lastItemInputComponents[(customer.Id, schema.Id, propertyName)]"
                                                Value="GetItemPropertyValue(item, propertyName)"
                                                ValueType="@propertyType"
                                                Min="@GetNumericRange(propertyName).min"
                                                Max="@GetNumericRange(propertyName).max"
                                                TabIndex="@tabIndex"
                                                OnInput="e => ItemPropertyInputChanged(item, propertyName, e)"/>
                                        }
                                        else
                                        {
                                            <DraftPropertyValueInput
                                                Value="GetItemPropertyValue(item, propertyName)"
                                                ValueType="@propertyType"
                                                Min="@GetNumericRange(propertyName).min"
                                                Max="@GetNumericRange(propertyName).max"
                                                TabIndex="@tabIndex"
                                                OnInput="e => ItemPropertyInputChanged(item, propertyName, e)"/>
                                        }
                                    </td>
                                    tabIndex++;
                                }

                                <td>
                                    <HxButton Color="ThemeColor.Secondary"
                                              CssClass="row-button"
                                              Icon="BootstrapIcon.Trash"
                                              Tooltip="Remove this item from the transaction."
                                              OnClick="async Task () => await DeleteItem(item.Id)" />
                                </td>
                            </tr>
                        }

                        <tr class="draft-items-ghost-row">
                            @{
                                if (!NewItems.TryGetValue((customer.Id, schema.Id), out Dictionary<string, object?>? propertiesDict))
                                {
                                    propertiesDict = new Dictionary<string, object?>();
                                    NewItems[(customer.Id, schema.Id)] = propertiesDict;
                                }

                                foreach ((string propertyName, Type propertyType) propertyColumn in propertyColumns)
                                {
                                    string propertyName = propertyColumn.propertyName;

                                    propertiesDict.TryAdd(propertyName, null);

                                    <td>
                                        <DraftPropertyValueInput
                                            @ref="newItemRowInputComponents[(customer.Id, schema.Id, propertyName)]"
                                            Value="@propertiesDict[propertyName]"
                                            ValueType="@propertyColumn.propertyType"
                                            Min="@GetNumericRange(propertyName).min"
                                            Max="@GetNumericRange(propertyName).max"
                                            TabIndex="@tabIndex"
                                            Placeholder="@(propertyColumn.propertyName)"
                                            OnInput="e => NewItemPropertyInputChanged(customer.Id, schema.Id, warehouse.Id, propertyName, e)"
                                            @key="NewItems[(customer.Id, schema.Id)]" />
                                    </td>
                                    tabIndex++;
                                }
                                <td>
                                    <span class="material-symbols-rounded new-item-plus"
                                          title="Add a new item to this list"
                                          @onclick="() => FocusNewItemRow(customer, schema)">add</span>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<HxModal @ref="_addItemListModal" Title="Add Item List">
    <BodyTemplate>
        <div class="d-flex flex-column gap-3">
            <HxSelect TItem="WarehouseBaseInfoDto" TValue="Guid?"
                      @bind-Value="_modalSelectedWarehouseId"
                      Data="_warehouses"
                      ValueSelector="w => w.Id"
                      TextSelector="w => w.Name"
                      Label="Target Warehouse"
                      Nullable="true" />
            <CustomerItemSchemaSelectorComponent @bind-CustomerId="SelectedCustomerToAdd"
                                                 @bind-ItemSchemaId="SelectedItemSchemaToAdd" />
        </div>
        @if (IsAddingExistingItemList)
        {
            <div class="text-danger mt-3">This item list has already been added to the transaction.</div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Text="Add" Color="ThemeColor.Primary" Enabled="@CanAddItemList" OnClick="BtnAddSchemaOnClick" />
        <HxButton Text="Cancel" Color="ThemeColor.Secondary" OnClick="() => _addItemListModal.HideAsync()" />
    </FooterTemplate>
</HxModal>
