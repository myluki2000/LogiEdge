@using LogiEdge.WarehouseService.Dto
@using LogiEdge.WarehouseService.Services.ItemsTable
@using LogiEdge.WarehouseService.Services.WarehouseManagement
@using LogiEdge.WebUI.Warehouse.Components.WarehouseItemTable

@inject TransactionManagementService TransactionService
@inject ItemsTableService ItemsTableService

@code
{
    [Parameter]
    public Guid TransactionId { get; set; }

    private List<Guid> _inboundNewItemStateIds = [];

    private ItemsTableFilterParameters? _filterParams;
    private ItemsTableSortParameters? _sortParams;
    private ItemsTableColumnDisplayParameters? _columnDisplayParams;

    private ItemsTableResultDto? _itemsOfTable = null;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        _inboundNewItemStateIds = await TransactionService.GetInboundNewItemStateIds(TransactionId);

        _filterParams ??= ItemsTableFilterParameters.FromQueryParameters([]);
        _sortParams ??= ItemsTableSortParameters.FromQueryParameters([]);
        _columnDisplayParams ??= ItemsTableColumnDisplayParameters.FromQueryParameters([]);

        await LoadItemsTable();
    }

    private async Task LoadItemsTable()
    {
        _itemsOfTable = await ItemsTableService.GetItemsAtStateAsync(
            _inboundNewItemStateIds,
            _sortParams,
            _filterParams);
    }

    private async Task OnItemsRefreshRequested()
    {
        await LoadItemsTable();
        StateHasChanged();
    }
}

@if (_itemsOfTable != null)
{
    <WarehouseItemAtStateTableComponent Items="_itemsOfTable"
                                        @bind-FilterParameters="_filterParams"
                                        @bind-ColumnDisplayParameters="_columnDisplayParams"
                                        @bind-SortParameters="_sortParams"
                                        OnItemsRefreshRequested="OnItemsRefreshRequested" />
}
else
{
    <HxSpinner />
}
