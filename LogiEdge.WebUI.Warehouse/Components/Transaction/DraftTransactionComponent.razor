@using LogiEdge.BaseService.Data
@using LogiEdge.Service.DocumentGenerator.Dto
@using LogiEdge.WarehouseService.Data.Transactions
@using LogiEdge.WarehouseService.Dto
@using LogiEdge.WarehouseService.Services.WarehouseManagement
@using LogiEdge.Shared
@using LogiEdge.WebUI.DocumentGenerator.Components
@using LogiEdge.WebUI.Shared.Components
@using LogiEdge.WebUI.Warehouse.Components.Transaction.Inbound
@using LogiEdge.WebUI.Warehouse.Components.Transaction.Outbound
@using Microsoft.AspNetCore.Components.Forms

@inject WarehouseManagementService WarehouseService
@inject TransactionManagementService TransactionService
@inject IHxMessageBoxService MessageBox
@inject NavigationManager NavigationManager
@inject IUserDirectory UserDirectory

@code {
    [Parameter]
    public required Guid TransactionId { get; set; }

    [Parameter]
    public EventCallback OnTransactionBooked { get; set; }

    private InventoryTransactionBaseInfoDto? _transaction = null;
    private string? _creatorName;

    private TransactionFileAttachmentManagerComponent _attachmentManager = null!;

    private DebouncerComponent _debouncer = null!;

    private bool IsAnyInputInvalid { get; set; }

    private string _selectedTab = "overview";

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        _transaction = await TransactionService.GetTransactionBaseInfo(TransactionId);
        if (_transaction != null)
            _creatorName = await UserDirectory.GetUserNameAsync(_transaction.CreatedByUserId);
    }

    private async Task RefreshTransactionAsync()
    {
        _transaction = await TransactionService.GetTransactionBaseInfo(TransactionId);
    }

    private void SelectTab(string tab)
    {
        _selectedTab = tab;
    }

    private void GoToTransactionsIndex()
    {
        NavigationManager.NavigateTo(RouteTo<Pages.Warehouse.Transactions.Index>());
    }

    private async Task BtnAddInboundItemsOnClick()
    {
        await TransactionService.AddInboundPartToTransaction(TransactionId);
        await RefreshTransactionAsync();
        _selectedTab = "inbound";
    }

    private async Task BtnAddOutboundItemsOnClick()
    {
        await TransactionService.AddOutboundPartToTransaction(TransactionId);
        await RefreshTransactionAsync();
        _selectedTab = "outbound";
    }

    private async Task BtnAddRelocationItemsOnClick()
    {
        await TransactionService.AddRelocationPartToTransaction(TransactionId);
        await RefreshTransactionAsync();
        _selectedTab = "relocation";
    }

    private async Task BookTransaction()
    {
        await TransactionService.BookTransaction(TransactionId);
        await OnTransactionBooked.InvokeAsync();
    }

    private async Task DeleteTransaction()
    {
        bool msgBoxResult = 
            await MessageBox.ConfirmAsync("Delete Transaction", "Are you sure you want to permanently delete this transaction? This cannot be reversed!");

        if (!msgBoxResult)
            return;

        await TransactionService.DeleteTransactionAsync(TransactionId);

        NavigationManager.NavigateTo(RouteTo<Pages.Warehouse.Transactions.Index>(), true);
    }

    private async Task SaveTitleToDatabaseAsync()
    {
        await TransactionService.SetTransactionTitle(_transaction.Id, _transaction.Title);
    }

    private void OnEventDateChanged(DateTime value)
    {
        if (_transaction == null)
            return;

        _transaction.EventDate = value;
        _debouncer.Debounce(SaveEventDateToDatabaseAsync);
    }

    private async Task SaveEventDateToDatabaseAsync()
    {
        await TransactionService.SetTransactionEventDate(_transaction.Id, _transaction.EventDate.ToUniversalTime());
    }

    private async Task DocumentGeneratorComponentOnFileAttachmentSaveRequested(GeneratedDocumentDto doc)
    {
        if (_transaction == null)
            return;

        await _attachmentManager.SaveGeneratedDocument(doc);
    }
}

@if (_transaction == null)
{
    <p>Transaction with ID @TransactionId could not be found.</p>
    return;
}

@if (_transaction.State != TransactionState.DRAFT)
{
    <p>Transaction is not in DRAFT state.</p>
    return;
}

<div class="tx-header">
        <div class="tx-meta d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="tx-icon-btn tx-back-btn" title="Back to transactions" aria-label="Back to transactions" @onclick="GoToTransactionsIndex">
                <span class="material-symbols-rounded">arrow_back</span>
            </button>
            <span class="badge tx-state-badge draft">Draft</span>
            <span>Created @_transaction.CreatedDate.ToLocalTime().ToString("G") by @(_creatorName ?? "unknown")</span>
            <span class="tx-meta-sep" aria-hidden="true"></span>
            <label class="tx-meta-label" for="tx-event-date">Event date</label>
            <InputDate id="tx-event-date" TValue="DateTime"
                       Type="InputDateType.DateTimeLocal"
                       Value="_transaction.EventDate"
                       ValueChanged="OnEventDateChanged"
                       ValueExpression="() => _transaction.EventDate"
                       class="form-control-sm tx-event-date" />

            <div class="d-flex align-items-center gap-2 flex-wrap tx-actions">
                <DebouncerComponent @ref="_debouncer"
                                    DelayMilliseconds="1000"
                                    class="tx-save-status"
                                    style="@(IsAnyInputInvalid ? "display: none;" : "")" />
                @if (IsAnyInputInvalid)
                {
                    <span class="tx-invalid d-flex align-items-center gap-1">
                        <span class="material-symbols-rounded tx-invalid-glyph">error</span>
                        Invalid inputs, fix before saving
                    </span>
                }

                <HxButton Text="Book Transaction" OnClick="BookTransaction" Color="ThemeColor.Primary" Size="ButtonSize.Small" />

                <DocumentGeneratorComponent TInputType="InventoryTransactionFullInfoDto"
                                            InputDataFunc="async () => await TransactionService.GetTransactionFullInfo(TransactionId)"
                                            OnFileAttachmentSaveRequested="DocumentGeneratorComponentOnFileAttachmentSaveRequested" />

                <button type="button" class="tx-icon-btn tx-delete-btn" title="Delete transaction" aria-label="Delete transaction" @onclick="DeleteTransaction">
                    <span class="material-symbols-rounded">delete</span>
                </button>
            </div>
        </div>

        <div class="tx-title-row">
            <InputText class="form-control tx-title-input"
                       placeholder="Untitled transaction"
                       @bind-Value="_transaction.Title"
                       @oninput="e => _debouncer.Debounce(async Task () => { _transaction.Title = e.Value?.ToString() ?? string.Empty; await SaveTitleToDatabaseAsync(); })" />
        </div>

        <ul class="nav nav-tabs tx-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(_selectedTab == "overview" ? "active" : "")"
                        role="tab" aria-selected="@(_selectedTab == "overview" ? "true" : "false")" @onclick='() => SelectTab("overview")'>Overview</button>
            </li>
            @if (_transaction.HasInboundPart)
            {
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link @(_selectedTab == "inbound" ? "active" : "")"
                            role="tab" aria-selected="@(_selectedTab == "inbound" ? "true" : "false")" @onclick='() => SelectTab("inbound")'>Inbound</button>
                </li>
            }
            @if (_transaction.HasOutboundPart)
            {
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link @(_selectedTab == "outbound" ? "active" : "")"
                            role="tab" aria-selected="@(_selectedTab == "outbound" ? "true" : "false")" @onclick='() => SelectTab("outbound")'>Outbound</button>
                </li>
            }
            @if (_transaction.HasRelocationPart)
            {
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link @(_selectedTab == "relocation" ? "active" : "")"
                            role="tab" aria-selected="@(_selectedTab == "relocation" ? "true" : "false")" @onclick='() => SelectTab("relocation")'>Relocation</button>
                </li>
            }
        </ul>
    </div>

    <div class="tx-content">
        @if (_selectedTab == "overview")
        {
            <div class="tx-overview" role="tabpanel">
                @if (!_transaction.HasInboundPart || !_transaction.HasOutboundPart || !_transaction.HasRelocationPart)
                {
                    <div class="tx-section tx-overview-parts">
                        <div class="tx-section-label">Add transaction parts</div>
                        <div class="d-flex flex-wrap gap-2 tx-part-actions">
                            @if (!_transaction.HasInboundPart)
                            {
                                <HxButton Text="Inbound items" Icon="BootstrapIcon.Plus" OnClick="BtnAddInboundItemsOnClick"
                                          Color="ThemeColor.Primary" Outline="true" Size="ButtonSize.Small" />
                            }
                            @if (!_transaction.HasOutboundPart)
                            {
                                <HxButton Text="Outbound items" Icon="BootstrapIcon.Plus" OnClick="BtnAddOutboundItemsOnClick"
                                          Color="ThemeColor.Primary" Outline="true" Size="ButtonSize.Small" />
                            }
                            @if (!_transaction.HasRelocationPart)
                            {
                                <HxButton Text="Relocation items" Icon="BootstrapIcon.Plus" OnClick="BtnAddRelocationItemsOnClick"
                                          Color="ThemeColor.Primary" Outline="true" Size="ButtonSize.Small" />
                            }
                        </div>
                    </div>
                }

                <div class="tx-overview-main">
                    <div class="tx-section">
                        <div class="tx-section-label">Documents &amp; attachments</div>
                        <div class="tx-attachments">
                            <TransactionFileAttachmentManagerComponent TransactionId="TransactionId" @ref="_attachmentManager" />
                        </div>
                    </div>
                </div>

                <div class="tx-overview-side">
                    <TransactionCommentsComponent TransactionId="TransactionId" />
                </div>
            </div>
        }
        else if (_selectedTab == "inbound")
        {
            <div role="tabpanel">
                <DraftInboundTransactionComponent TransactionId="TransactionId"
                                                  Debouncer="_debouncer"
                                                  @bind-IsAnyInputInvalid="IsAnyInputInvalid" />
            </div>
        }
        else if (_selectedTab == "outbound")
        {
            <div role="tabpanel">
                <DraftOutboundTransactionComponent TransactionId="TransactionId" />
            </div>
        }
        else if (_selectedTab == "relocation")
        {
            <div class="text-muted" role="tabpanel">ToDo: Relocation transaction part</div>
        }
    </div>
