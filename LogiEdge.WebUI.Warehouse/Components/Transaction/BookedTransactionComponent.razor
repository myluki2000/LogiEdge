@using LogiEdge.BaseService.Data
@using LogiEdge.BaseService.Dto
@using LogiEdge.Service.DocumentGenerator.Dto
@using LogiEdge.WarehouseService.Data.Transactions
@using LogiEdge.WarehouseService.Dto
@using LogiEdge.WarehouseService.Services.WarehouseManagement
@using LogiEdge.Shared
@using LogiEdge.WebUI.DocumentGenerator.Components
@using LogiEdge.WebUI.Shared.Components
@using LogiEdge.WebUI.Warehouse.Components.Transaction.Inbound
@using LogiEdge.WebUI.Warehouse.Components.Transaction.Outbound
@using Microsoft.AspNetCore.Components.Forms

@inject TransactionManagementService TransactionService
@inject IUserDirectory UserDirectory
@inject NavigationManager NavigationManager

@code {
    [Parameter]
    public required Guid TransactionId { get; set; }

    private InventoryTransactionBaseInfoDto? _transaction { get; set; }
    private string? _creatorName;

    private TransactionFileAttachmentManagerComponent _attachmentManager = null!;
    private DebouncerComponent _debouncer = null!;
    private HxModal _editHistoryModal = null!;

    private List<TransactionEditLogEntryDto>? _editHistory;
    private IReadOnlyDictionary<Guid, string> _editHistoryAuthorNames = new Dictionary<Guid, string>();

    /// <summary>Bumped after a part edit so that the part components reload their read views.</summary>
    private int _revision = 0;

    private string _selectedTab = "overview";

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        _transaction = await TransactionService.GetTransactionBaseInfo(TransactionId);
        if (_transaction != null)
            _creatorName = await UserDirectory.GetUserNameAsync(_transaction.CreatedByUserId);
    }

    private async Task SaveTitleToDatabaseAsync()
    {
        await TransactionService.SetTransactionTitle(_transaction.Id, _transaction.Title);
    }

    private void SelectTab(string tab)
    {
        _selectedTab = tab;
    }

    private void GoToTransactionsIndex()
    {
        NavigationManager.NavigateTo(RouteTo<Pages.Warehouse.Transactions.Index>());
    }

    private async Task ShowEditHistoryModalAsync()
    {
        if (_editHistory == null)
        {
            _editHistory = await TransactionService.GetTransactionEditHistory(TransactionId);
            _editHistoryAuthorNames = await UserDirectory.GetUserNamesAsync(_editHistory.Select(e => e.EditedByUserId));
        }

        await _editHistoryModal.ShowAsync();
    }

    private async Task HandlePartEditedAsync()
    {
        // Re-fetch the base info (the "edited" badge may have just appeared) and force the part
        // components to reload their read views.
        _transaction = await TransactionService.GetTransactionBaseInfo(TransactionId);
        _revision++;
    }

    private async Task DocumentGeneratorComponentOnSaveRequested(GeneratedDocumentDto doc)
    {
        if (_transaction == null)
            return;

        await _attachmentManager.SaveGeneratedDocument(doc);
    }

    private async Task<string?> GetPreFilledUserInputAsync()
    {
        try
        {
            List<FileAttachmentDto> attachments = await TransactionService.GetAttachments(TransactionId);
            return attachments.LastOrDefault(a => a.UserInputJson != null)?.UserInputJson;
        }
        catch
        {
            return null; // pre-fill is best-effort — never break generation
        }
    }
}

@if (_transaction == null)
{
    <p>Transaction with ID @TransactionId could not be found.</p>
    return;
}

@if (_transaction.State != TransactionState.BOOKED)
{
    <p>Unexpected transaction state: @_transaction.State</p>
}

<div class="tx-header">
        <div class="tx-meta d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="tx-icon-btn tx-back-btn" title="Back to transactions" aria-label="Back to transactions" @onclick="GoToTransactionsIndex">
                <span class="material-symbols-rounded">arrow_back</span>
            </button>
            <span class="badge tx-state-badge booked">Booked</span>
            @if (_transaction.HasEditHistory)
            {
                <span class="badge rounded-pill text-bg-warning edit-history-badge"
                      title="View edit history"
                      @onclick="ShowEditHistoryModalAsync">edited<HxIcon Icon="BootstrapIcon.Question" CssClass="ms-1"/></span>
            }
            <span>Created @_transaction.CreatedDate.ToLocalTime().ToString("G") by @(_creatorName ?? "unknown")</span>
            <span class="tx-meta-sep" aria-hidden="true"></span>
            <span>Event @_transaction.EventDate.ToLocalTime().ToString("G")</span>
            <span class="tx-meta-sep" aria-hidden="true"></span>
            <span>Booked @(_transaction.BookedDate?.ToLocalTime().ToString("G") ?? "—")</span>

            <div class="d-flex align-items-center gap-2 flex-wrap tx-actions">
                <DebouncerComponent @ref="_debouncer" DelayMilliseconds="1000" class="tx-save-status" />
                <DocumentGeneratorComponent InputDataFunc="async () => await TransactionService.GetTransactionFullInfo(TransactionId)"
                                            PreFilledUserInputFunc="GetPreFilledUserInputAsync"
                                            OnFileAttachmentSaveRequested="DocumentGeneratorComponentOnSaveRequested" />
            </div>
        </div>

        <div class="tx-title-row">
            <InputText class="form-control tx-title-input"
                       placeholder="Untitled transaction"
                       @bind-Value="_transaction.Title"
                       @oninput="e => _debouncer.Debounce(async Task () => { _transaction.Title = e.Value?.ToString() ?? string.Empty; await SaveTitleToDatabaseAsync(); })" />
        </div>

        <ul class="nav nav-tabs tx-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(_selectedTab == "overview" ? "active" : "")"
                        role="tab" aria-selected="@(_selectedTab == "overview" ? "true" : "false")" @onclick='() => SelectTab("overview")'>Overview</button>
            </li>
            @if (_transaction.HasInboundPart)
            {
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link @(_selectedTab == "inbound" ? "active" : "")"
                            role="tab" aria-selected="@(_selectedTab == "inbound" ? "true" : "false")" @onclick='() => SelectTab("inbound")'>Inbound</button>
                </li>
            }
            @if (_transaction.HasOutboundPart)
            {
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link @(_selectedTab == "outbound" ? "active" : "")"
                            role="tab" aria-selected="@(_selectedTab == "outbound" ? "true" : "false")" @onclick='() => SelectTab("outbound")'>Outbound</button>
                </li>
            }
            @if (_transaction.HasRelocationPart)
            {
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link @(_selectedTab == "relocation" ? "active" : "")"
                            role="tab" aria-selected="@(_selectedTab == "relocation" ? "true" : "false")" @onclick='() => SelectTab("relocation")'>Relocation</button>
                </li>
            }
        </ul>
    </div>

    <div class="tx-content">
        @if (_selectedTab == "overview")
        {
            <div class="tx-overview" role="tabpanel">
                <div class="tx-overview-main">
                    <div class="tx-section">
                        <div class="tx-section-label">Documents &amp; attachments</div>
                        @if (_transaction.HasEditHistory)
                        {
                            <HxAlert Color="ThemeColor.Warning" class="tx-edit-warning">
                                This transaction was edited after booking — previously generated documents may be out of date.
                            </HxAlert>
                        }
                        <div class="tx-attachments">
                            <TransactionFileAttachmentManagerComponent TransactionId="TransactionId" @ref="_attachmentManager" />
                        </div>
                    </div>
                </div>

                <div class="tx-overview-side">
                    <TransactionCommentsComponent TransactionId="TransactionId" />
                </div>
            </div>
        }
        else if (_selectedTab == "inbound")
        {
            <div role="tabpanel">
                <BookedInboundTransactionComponent TransactionId="TransactionId"
                                                  Revision="_revision"
                                                  OnPartEdited="HandlePartEditedAsync" />
            </div>
        }
        else if (_selectedTab == "outbound")
        {
            <div role="tabpanel">
                <BookedOutboundTransactionComponent TransactionId="TransactionId"
                                                   Revision="_revision"
                                                   OnPartEdited="HandlePartEditedAsync" />
            </div>
        }
        else if (_selectedTab == "relocation")
        {
            <div class="text-muted" role="tabpanel">TODO: Relocation transaction details component</div>
        }
    </div>

<HxModal @ref="_editHistoryModal" Title="Edit history">
    <BodyTemplate>
        @if (_editHistory == null)
        {
            <HxSpinner />
        }
        else if (_editHistory.Count == 0)
        {
            <p class="text-muted mb-0">No edit history entries.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (TransactionEditLogEntryDto entry in _editHistory)
                {
                    <li class="mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-muted">@entry.EditedDate.ToLocalTime().ToString("G")</span>
                            <span class="small text-muted">@_editHistoryAuthorNames.GetValueOrDefault(entry.EditedByUserId, "unknown")</span>
                            <span class="small text-muted">@(entry.PartType?.ToString() ?? "transaction")</span>
                        </div>
                        <div>@entry.ChangeSummary</div>
                        <pre class="small text-muted mb-0">@entry.ChangesJson</pre>
                    </li>
                }
            </ul>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Text="Close" Color="ThemeColor.Secondary" OnClick="() => _editHistoryModal.HideAsync()" />
    </FooterTemplate>
</HxModal>
