@using LogiEdge.BaseService.Data
@using LogiEdge.BaseService.Dto
@using LogiEdge.BaseService.Services
@using LogiEdge.WarehouseService.Services.WarehouseManagement
@using LogiEdge.WebUI.Shared.Components

@inject FileAttachmentService FileAttachmentService
@inject TransactionManagementService TransactionService

@code {
    [Parameter]
    public required Guid TransactionId { get; set; }

    private List<FileAttachmentDto> _attachments = [];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        _attachments = await TransactionService.GetAttachments(TransactionId);
    }

    private async Task OnAttachmentsUploaded(List<FileAttachmentDto> newAttachments)
    {
        foreach (FileAttachmentDto attachment in newAttachments)
        {
            FileAttachmentDto entity = await FileAttachmentService.CreateAttachment(attachment.FileName, attachment.ContentType, attachment.Data!);
            _attachments.Add(entity);
            await TransactionService.AddAttachment(TransactionId, entity.Id);
        }
    }

    private async Task OnAttachmentRemoved(Guid attachmentId)
    {
        await TransactionService.RemoveAttachment(TransactionId, attachmentId);
        await FileAttachmentService.DeleteAttachment(attachmentId);
        _attachments.RemoveAll(a => a.Id == attachmentId);
    }
}

<FileAttachmentManagerComponent Attachments="@_attachments"
                                OnAttachmentsUploaded="OnAttachmentsUploaded"
                                OnAttachmentRemoveRequested="OnAttachmentRemoved" />
